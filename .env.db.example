# ── DB SERVER environment ─────────────────────────────────────────────────────
# Copy to .env.db on the GCP DB VM, fill in values, never commit real values.

POSTGRES_USER=marketlens
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marketlens

# GCP Cloud Storage backup (via interoperability S3-compatible API).
# Create an HMAC key in GCP Console → Cloud Storage → Settings → Interoperability.
BACKUP_S3_ACCESS_KEY=your_gcs_hmac_access_key
BACKUP_S3_SECRET_KEY=your_gcs_hmac_secret_key
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=marketlens-backups
