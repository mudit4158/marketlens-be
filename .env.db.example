# ── DB SERVER environment ─────────────────────────────────────────────────────
# Copy to .env.db on the DB server, fill in values, never commit real values.

POSTGRES_USER=marketlens
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marketlens

# S3-compatible object storage for daily backups.
# Works with AWS S3, Hetzner Object Storage, Backblaze B2, Wasabi, etc.
BACKUP_S3_ACCESS_KEY=your_access_key
BACKUP_S3_SECRET_KEY=your_secret_key
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=marketlens-backups
