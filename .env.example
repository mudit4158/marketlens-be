ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://marketlens:marketlens@localhost:5433/marketlens

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEX=

# Scheduler (all times UTC)
SCHEDULER_ENABLED=true
SCHEDULER_CRON_HOUR=22
SCHEDULER_CRON_MINUTE=0
SCHEDULER_CRON_DAY_OF_WEEK=mon-fri
SCHEDULER_INGESTION_DAYS=5
SCHEDULER_INGESTION_INTERVAL=1d
SCHEDULER_SOURCE_NAME=yfinance
